# ========================================================
# RJDL* Enquiry Form Environment Configuration
# ========================================================

# Your Gmail address that will authenticate and send the emails
GMAIL_USER=rjdlxindia@gmail.com

# 16-character Gmail App Password (NOT your regular Google password)
# How to get it:
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Security -> 2-Step Verification (must be turned ON)
# 3. Search "App passwords" -> Create an app named "RJDLx Website"
# 4. Copy the generated 16-character password (e.g. abcd efgh ijkl mnop)
GMAIL_APP_PASSWORD=your_16_character_app_password

# Where incoming enquiries will be delivered (defaults to rjdlxindia@gmail.com)
RECIPIENT_EMAIL=rjdlxindia@gmail.com

# Server port (optional, defaults to 4583)
PORT=4583
