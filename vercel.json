{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/enquiry.js", "use": "@vercel/node" }
  ],
  "cleanUrls": true,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/collection-storage", "destination": "/collection-metal-shelves", "permanent": true },
    { "source": "/collection-woven-metal", "destination": "/collection-natural-yarn", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/enquiry",
      "destination": "/api/enquiry.js"
    }
  ]
}
